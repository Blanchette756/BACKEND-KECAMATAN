# Salin file ini menjadi .env lalu sesuaikan. JANGAN commit file .env.

# development | test | production
NODE_ENV=development

# Hostinger mengisi PORT otomatis. Di lokal default 3000.
PORT=3000
HOST=0.0.0.0

# Zona waktu untuk nomor registrasi (Tarakan = WITA)
APP_TIMEZONE=Asia/Makassar

# Asal (origin) frontend yang boleh mengakses API, pisahkan dengan koma.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Set "true" jika server berada di belakang proxy (Hostinger / Cloudflare),
# agar rate limit membaca IP asli pengunjung.
TRUST_PROXY=false

# Fase 1 hanya mendukung "mock" (login tanpa password, khusus pengembangan).
AUTH_MODE=mock
# Di NODE_ENV=production, server MENOLAK start dengan auth mock,
# kecuali flag ini diisi true secara sadar (misalnya untuk demo ke mitra).
ALLOW_MOCK_AUTH_IN_PRODUCTION=false
# Masa berlaku sesi login (menit)
SESSION_TTL_MINUTES=480

# Halaman dokumentasi API di /docs.
# Biarkan dikomentari: otomatis AKTIF di development dan MATI di production.
# ENABLE_DOCS=true

# Batas ukuran per berkas (MB) dan jumlah berkas per pengajuan
MAX_FILE_MB=2
MAX_FILES_PER_PENGAJUAN=15

# Rate limit (permintaan per menit per IP)
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_LACAK=10
RATE_LIMIT_LOGIN=10

# Isi beberapa contoh pengajuan di berbagai status saat start (untuk demo frontend)
SEED_DEMO_PENGAJUAN=true

# Lokasi folder data master (default: ./data)
# DATA_DIR=./data

LOG_LEVEL=info
