{
  "name": "kecamatan-tarakan-timur-api",
  "version": "0.1.0",
  "description": "Backend REST API Sistem Informasi Pelayanan Publik Kecamatan Tarakan Timur (Fase 1: dummy-first)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate-data": "tsx src/scripts/validate-data.ts",
    "audit:deps": "npm audit --omit=dev",
    "check": "npm run typecheck && npm test && npm run validate-data"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "fastify": "^5.12.7",
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  }
}
